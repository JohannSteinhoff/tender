rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSelfPromotionAttempt() {
      return request.resource.data.isAdmin == true
        && (!resource.data.keys().hasAny(['isAdmin']) || resource.data.isAdmin != true);
    }

    function validShortText(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    function validCommentPayload() {
      return request.resource.data.userId == request.auth.uid
        && validShortText(request.resource.data.text, 1000)
        && request.resource.data.likeCount is int
        && request.resource.data.likeCount >= 0
        && request.resource.data.likedBy is list
        && request.resource.data.displayName is string;
    }

    function validReplyPayload(commentId) {
      return request.resource.data.userId == request.auth.uid
        && request.resource.data.parentCommentId == commentId
        && validShortText(request.resource.data.text, 1000)
        && request.resource.data.displayName is string;
    }

    function validNotificationCreate(recipientId) {
      return request.resource.data.recipientUserId == recipientId
        && request.resource.data.actorUserId == request.auth.uid
        && request.resource.data.type in [
          'recipe_comment', 'comment_reply', 'admin_recipe_removed', 'admin_comment_removed',
          'grocery_list_invite', 'grocery_list_invite_response'
        ]
        && request.resource.data.isRead == false;
    }

    function isSeedRecipeOwnerAssignment() {
      return isSignedIn()
        && (resource.data.createdBy == null || resource.data.createdBy == 'system')
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['createdBy']);
    }

    // Users can read/write their own profile
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && request.resource.data.isAdmin != true;
      allow update: if isAdmin() || (
        isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin'])
        && !isSelfPromotionAttempt()
      );
      allow delete: if isAdmin();

      // Swipes subcollection - only the owning user
      match /swipes/{recipeId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Grocery subcollection - only the owning user
      match /grocery/{itemId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Meal plan subcollection - only the owning user
      match /mealplan/{itemId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Notification settings doc — any signed-in user can read (needed to
      // check recipient prefs before creating a notification); only the
      // owner can write their own prefs.
      match /settings/{docId} {
        allow read: if isSignedIn();
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Notifications - recipient can read/update; any authenticated actor can create for recipient
      match /notifications/{notificationId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && validNotificationCreate(userId);
        allow update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'status']);
        allow delete: if false;
      }
    }

    // Recipes - anyone can read published recipes (guest browsing);
    // only signed-in users can create; only the creator or an admin can update/delete
    match /recipes/{recipeId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        // Any logged-in user can update likeCount (for liking/unliking)
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
        // Full edits require being the creator or admin
        || resource.data.createdBy == request.auth.uid
        || isSeedRecipeOwnerAssignment()
        || isAdmin()
      );
      allow delete: if isSignedIn() && (
        resource.data.createdBy == request.auth.uid ||
        isAdmin()
      );

      // Recipe comments — anyone can read; only signed-in users can write
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
          && validCommentPayload();
        allow update: if request.auth != null && (
          resource.data.userId == request.auth.uid
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt'])
        );
        allow delete: if request.auth != null && (
          resource.data.userId == request.auth.uid
          || isAdmin()
        );

        // Replies under a comment — anyone can read; only signed-in users can write
        match /replies/{replyId} {
          allow read: if true;
          allow create: if request.auth != null
            && validReplyPayload(commentId);
          allow update: if request.auth != null && resource.data.userId == request.auth.uid;
          allow delete: if request.auth != null && (
            resource.data.userId == request.auth.uid
            || isAdmin()
          );
        }
      }
    }

    // Shared grocery brand recommendations are readable by signed-in users.
    // They are populated out-of-band from USDA data and are not client-writable.
    match /groceryBrandRecommendations/{ingredientId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Global category overrides — readable by all signed-in users,
    // writable only by admins.
    match /groceryCategoryOverrides/{ingredientId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Shared grocery lists — membership-gated. A user's uid must be in the
    // members array to read/write the list or its items. Joining requires
    // an invite: the owner adds a uid to invitedUids, and only that same
    // uid can move themselves from invitedUids into members (accept) or
    // drop themselves from invitedUids (decline) — nobody can add
    // themselves straight to members.
    match /groceryLists/{listId} {
      function isMember() {
        return isSignedIn() && request.auth.uid in resource.data.members;
      }

      function isInvited() {
        return isSignedIn() && request.auth.uid in resource.data.get('invitedUids', []);
      }

      function isListOwner() {
        return isSignedIn() && request.auth.uid == resource.data.ownerId;
      }

      // A non-owner member may only remove themselves — nothing else about
      // the doc may change in that same write.
      function isSelfLeave() {
        return isMember()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members == resource.data.members.removeAll([request.auth.uid])
          && !(request.auth.uid in request.resource.data.members);
      }

      // An invitee accepting: moves their own uid from invitedUids to
      // members in one write, touching nothing else.
      function isSelfAccept() {
        return isInvited()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'invitedUids'])
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.hasAll(resource.data.members)
          && request.auth.uid in request.resource.data.members
          && request.resource.data.invitedUids == resource.data.invitedUids.removeAll([request.auth.uid]);
      }

      // An invitee declining (or the owner cancelling a pending invite):
      // just drops the uid from invitedUids.
      function isSelfDecline() {
        return isInvited()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['invitedUids'])
          && request.resource.data.invitedUids == resource.data.invitedUids.removeAll([request.auth.uid]);
      }

      allow read: if isMember() || isInvited();
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.members == [request.auth.uid];
      allow update: if isListOwner() || isSelfLeave() || isSelfAccept() || isSelfDecline();
      allow delete: if isListOwner();

      match /items/{itemId} {
        allow read, write: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groceryLists/$(listId)).data.members;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
