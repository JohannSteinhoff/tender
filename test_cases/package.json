{
  "name": "tender-story2-tests",
  "version": "1.0.0",
  "type": "module",
  "description": "Tender test suite (unit and integration coverage)",
  "scripts": {
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest --reporter=verbose",
    "test:unit": "vitest run unit --reporter=verbose",
