{
  "name": "tender-story2-tests",
  "version": "1.0.0",
  "type": "module",
  "description": "Tender test suite (unit acceptance coverage for discover and comments stories)",
  "scripts": {
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest --reporter=verbose",
    "test:unit": "vitest run unit --reporter=verbose",
    "test:discover": "vitest run unit/discover --reporter=verbose",
    "test:comments": "vitest run unit/comments --reporter=verbose",
    "test:fr31": "vitest run unit/discover/discover-grid.test.js --reporter=verbose",
    "test:fr32": "vitest run unit/discover/discover-recipe-card-fields.test.js --reporter=verbose",
    "test:fr33": "vitest run unit/discover/discover-search-filter.test.js --reporter=verbose",
    "test:fr34": "vitest run unit/discover/discover-cuisine-filter.test.js --reporter=verbose",
    "test:fr35": "vitest run unit/discover/discover-difficulty-filter.test.js --reporter=verbose",
    "test:fr36": "vitest run unit/discover/discover-dietary-filter.test.js --reporter=verbose",
    "test:fr37": "vitest run unit/discover/discover-recipe-modal.test.js --reporter=verbose",
    "test:fr38": "vitest run unit/discover/discover-like-unlike.test.js --reporter=verbose",
    "test:fr39": "vitest run unit/discover/discover-add-to-plan.test.js --reporter=verbose",
    "test:fr40": "vitest run unit/discover/discover-create-recipe-modal.test.js --reporter=verbose",
    "test:fr41": "vitest run unit/comments/comments-acceptance.test.js --reporter=verbose"
  },
  "devDependencies": {
    "vitest": "^1.6.0"
  }
}
