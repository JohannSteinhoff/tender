{
  "name": "tender-story2-tests",
  "version": "1.0.0",
  "type": "module",
  "description": "Tender test suite (unit and integration coverage)",
  "scripts": {
    "test": "vitest run --config ./vitest.config.js --reporter=verbose",
    "test:watch": "vitest --config ./vitest.config.js --reporter=verbose",
    "test:unit": "vitest run --config ./vitest.config.js unit --reporter=verbose",
    "test:integration": "npx firebase-tools emulators:exec --project tender-a7367 --config ../firebase.json --only firestore \"vitest run --config ./vitest.config.js integration --reporter=verbose\"",
    "test:integration:comments": "npx firebase-tools emulators:exec --project tender-a7367 --config ../firebase.json --only firestore \"vitest run --config ./vitest.config.js integration/comments --reporter=verbose\"",
    "test:discover": "vitest run --config ./vitest.config.js unit/discover --reporter=verbose",
    "test:comments": "vitest run --config ./vitest.config.js unit/comments --reporter=verbose",
    "test:recommendations": "vitest run --config ./vitest.config.js unit/recommendations --reporter=verbose",
    "test:fr31": "vitest run --config ./vitest.config.js unit/discover/discover-grid.test.js --reporter=verbose",
    "test:fr32": "vitest run --config ./vitest.config.js unit/discover/discover-recipe-card-fields.test.js --reporter=verbose",
    "test:fr33": "vitest run --config ./vitest.config.js unit/discover/discover-search-filter.test.js --reporter=verbose",
    "test:fr34": "vitest run --config ./vitest.config.js unit/discover/discover-cuisine-filter.test.js --reporter=verbose",
    "test:fr35": "vitest run --config ./vitest.config.js unit/discover/discover-difficulty-filter.test.js --reporter=verbose",
    "test:fr36": "vitest run --config ./vitest.config.js unit/discover/discover-dietary-filter.test.js --reporter=verbose",
    "test:fr37": "vitest run --config ./vitest.config.js unit/discover/discover-recipe-modal.test.js --reporter=verbose",
    "test:fr38": "vitest run --config ./vitest.config.js unit/discover/discover-like-unlike.test.js --reporter=verbose",
    "test:fr39": "vitest run --config ./vitest.config.js unit/discover/discover-add-to-plan.test.js --reporter=verbose",
    "test:fr40": "vitest run --config ./vitest.config.js unit/discover/discover-create-recipe-modal.test.js --reporter=verbose",
    "test:fr41": "vitest run --config ./vitest.config.js unit/comments/comments-acceptance.test.js --reporter=verbose",
    "test:fr42": "vitest run --config ./vitest.config.js unit/recommendations/recommendations-acceptance.test.js --reporter=verbose",
    "test:fr58": "vitest run --config ./vitest.config.js FR-58-67.test.js --reporter=verbose"
